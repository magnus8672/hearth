{
    admin off
    auto_https disable_redirects
}
(hearth_headers) {
    tls internal
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self'; script-src 'self'; connect-src 'self' blob:; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
    }
}
(bff_proxy) {
    reverse_proxy {args[0]} {
        header_up -Forwarded
        header_up -X-User-ID
        header_up -X-Client-Cert
        header_up -X-Forwarded-Client-Cert
        header_up X-Forwarded-Proto https
    }
}
(browser_trust_probe) {
    # Static, credential-free response used by the local setup browser itself.
    handle /health/browser {
        header Content-Type application/json
        header Access-Control-Allow-Origin *
        header Cache-Control no-store
        respond "{\"service\":\"{args[0]}\",\"status\":\"ok\"}" 200
    }
}
https://localhost:8443, https://127.0.0.1:8443 {
    import hearth_headers
    request_body {
        max_size 1048576
    }
    import browser_trust_probe hearth-admin
    @api path /api/* /auth/* /health/ready /health/live
    handle @api {
        import bff_proxy api:8080
    }
    handle {
        root * /srv/admin
        try_files {path} /index.html
        file_server
    }
}
https://localhost:8444 {
    import hearth_headers
    header Permissions-Policy "microphone=(self)"
    @image_upload {
        method POST
        path_regexp "^/api/v1/(chats/[0-9a-fA-F-]{36}/(attachments|transcriptions)|channels/[0-9a-fA-F-]{36}/attachments)$"
    }
    @geometry_upload {
        method POST
        path /api/v1/geometry /api/v1/images
    }
    @ordinary_body {
        not {
            method POST
            path_regexp "^/api/v1/(geometry|images|chats/[0-9a-fA-F-]{36}/(attachments|transcriptions)|channels/[0-9a-fA-F-]{36}/attachments)$"
        }
    }
    request_body @image_upload {
        max_size 8388608
    }
    # Match the BFF envelope limit, including base64 overhead for an 8 MiB image.
    request_body @geometry_upload {
        max_size 12100000
    }
    request_body @ordinary_body {
        max_size 1048576
    }
    import browser_trust_probe hearth-user
    @api path /api/* /auth/* /health/ready /health/live /v1/* /mcp
    handle @api {
        import bff_proxy user-api:8080
    }
    handle {
        root * /srv/user
        try_files {path} /index.html
        file_server
    }
}
https://localhost:8445 {
    tls internal
    import browser_trust_probe hearth-identity
    @identity path /realms/hearth/* /resources/* /robots.txt
    handle @identity {
        reverse_proxy keycloak:8085 {
            header_up -Forwarded
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Host localhost:8445
            header_up X-Forwarded-Port 8445
        }
    }
    respond 404
}
